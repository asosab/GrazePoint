# GrazePoint backend — variables de entorno

# MongoDB propio del proyecto (local o producción).
GRAZEPOINT_MONGO_URI=mongodb://admin:PASSWORD@127.0.0.1:27017/grazepoint?authSource=admin

# JWT propio del servicio (independiente de cualquier otro sistema).
GRAZEPOINT_JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
GRAZEPOINT_JWT_EXPIRES=30d

# Correos al usuario vía cuenta de Google con clave de aplicación
# (https://myaccount.google.com/apppasswords).
GRAZEPOINT_SMTP_HOST=smtp.gmail.com
GRAZEPOINT_SMTP_PORT=465
GRAZEPOINT_SMTP_USER=tu-cuenta@gmail.com
GRAZEPOINT_SMTP_PASS=clave-de-aplicacion-16-letras
GRAZEPOINT_MAIL_FROM=GrazePoint <tu-cuenta@gmail.com>

# Orígenes permitidos (CORS Bearer, sin cookies).
GRAZEPOINT_CORS_ORIGINS=https://asosab.github.io,http://localhost:4000,http://127.0.0.1:4000

# Puerto del servidor standalone.
PORT=8080

# Bot de Telegram @grazepoint_bot (BotFather). Sin token el poller no
# arranca y el resto del servicio funciona igual.
GRAZEPOINT_TG_TOKEN=
GRAZEPOINT_TG_BOT=grazepoint_bot
# Chat id de Telegram del admin (código de control: comandos admin).
GRAZEPOINT_TG_ADMIN=
