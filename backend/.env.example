# Field Shift backend — variables de entorno

# MongoDB propio del proyecto (local o producción).
FIELDSHIFT_MONGO_URI=mongodb://admin:PASSWORD@127.0.0.1:27017/fieldShift?authSource=admin

# JWT propio del servicio (independiente de cualquier otro sistema).
FIELDSHIFT_JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
FIELDSHIFT_JWT_EXPIRES=30d

# Correos al usuario vía cuenta de Google con clave de aplicación
# (https://myaccount.google.com/apppasswords).
FIELDSHIFT_SMTP_HOST=smtp.gmail.com
FIELDSHIFT_SMTP_PORT=465
FIELDSHIFT_SMTP_USER=tu-cuenta@gmail.com
FIELDSHIFT_SMTP_PASS=clave-de-aplicacion-16-letras
FIELDSHIFT_MAIL_FROM=Field Shift <tu-cuenta@gmail.com>

# Orígenes permitidos (CORS Bearer, sin cookies).
FIELDSHIFT_CORS_ORIGINS=https://asosab.github.io,http://localhost:4000,http://127.0.0.1:4000

# Puerto del servidor standalone.
PORT=8080
